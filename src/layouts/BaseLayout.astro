---
import '@fontsource/anton';
import '@fontsource-variable/inter/wght.css';
import '../styles/global.css';

import antonLatin from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import antonLatinExt from '@fontsource/anton/files/anton-latin-ext-400-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

import { getImage } from 'astro:assets';
import { site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.seo.title, description = site.seo.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: site.hero.image, width: 1200, height: 630, format: 'jpg', fit: 'cover', quality: 80 });
const ogUrl = new URL(og.src, Astro.site);

const t = site.theme;
const themeVars = `:root{--black:${t.black};--charcoal:${t.charcoal};--graphite:${t.graphite};--off-white:${t.offWhite};--muted:${t.muted};--accent:${t.accent};--on-accent:${t.onAccent};}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HealthAndBeautyBusiness',
  name: site.brand.name,
  description,
  url: canonical.href,
  image: ogUrl.href,
  email: site.contact.email,
  telephone: site.contact.phone,
  address: { '@type': 'PostalAddress', streetAddress: site.contact.address, addressLocality: site.brand.city, addressCountry: 'HU' },
  sameAs: site.social.map((s) => s.href),
};
---

<!doctype html>
<html lang={site.brand.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content={t.black} />
    <meta name="color-scheme" content="dark" />

    <!-- JS jelenlét jelzése: csak ekkor rejtjük el az animálandó elemeket -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href={antonLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={antonLatinExt} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.brand.locale} />
    <meta property="og:site_name" content={site.brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.seo.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <style set:html={themeVars}></style>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Ugrás a tartalomra</a>
    <slot />
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
