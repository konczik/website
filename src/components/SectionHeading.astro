---
import { richLines } from '../lib/text';

interface Props {
  /** Opcionális, mondatszerű bevezető a cím fölött — csak ha valódi információt hordoz. */
  kicker?: string;
  title: string;
  as?: 'h1' | 'h2' | 'h3';
  size?: 'xxl' | 'xl' | 'lg' | 'md';
  id?: string;
  class?: string;
}

const { kicker, title, as: Tag = 'h2', size = 'lg', id, class: className = '' } = Astro.props;
---

<header class:list={['section-heading', className]}>
  {kicker && <p class="kicker" data-reveal="up">{kicker}</p>}
  <Tag id={id} class:list={['display', `display--${size}`]} data-reveal="mask" set:html={richLines(title)} />
</header>

<style>
  .section-heading {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
</style>
