---
import { site } from '../config/site';

const { brand, nav, social, footer, contact } = site;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <p class="footer__tagline">{footer.tagline}</p>
      <nav aria-label="Lábléc navigáció">
        <ul class="footer__links">
          {
            nav.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))
          }
          <li><a href={nav.cta.href}>{nav.cta.label}</a></li>
        </ul>
      </nav>
      <ul class="footer__links">
        {
          social.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener">
                {s.label}
              </a>
            </li>
          ))
        }
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
      </ul>
    </div>

    <p class="footer__mark" aria-hidden="true" data-reveal="up">{brand.logoText}</p>

    <div class="footer__bottom">
      <p>© {year} {brand.name}. Minden jog fenntartva.</p>
      <ul>
        {
          footer.legal.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
        <li><a href="#top">Vissza fel ↑</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(4rem, 8vw, 6rem) 2rem;
    padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));
    background: var(--black);
    border-top: 1px solid var(--line);
  }
  .footer__top {
    display: grid;
    gap: 2.5rem;
  }
  .footer__tagline {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    text-transform: uppercase;
  }
  .footer__links {
    display: grid;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: rgb(242 239 233 / 0.75);
  }
  .footer a {
    transition: color 300ms;
  }
  .footer a:hover,
  .footer a:focus-visible {
    color: var(--accent);
  }
  .footer__mark {
    margin-top: clamp(3.5rem, 8vw, 6rem);
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 14.5vw, 15rem);
    line-height: 0.82;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--off-white);
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: 0.78rem;
    color: var(--muted);
  }
  .footer__bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  @media (min-width: 48em) {
    .footer__top {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>
