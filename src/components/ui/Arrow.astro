---
interface Props {
  class?: string;
  direction?: 'right' | 'down';
}
const { class: className = '', direction = 'right' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  aria-hidden="true"
  focusable="false"
  style={direction === 'down' ? 'transform: rotate(90deg)' : undefined}
>
  <path d="M3 12h17M14 6l6 6-6 6" stroke-linecap="square"></path>
</svg>
