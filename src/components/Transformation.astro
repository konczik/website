---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import SectionHeading from './SectionHeading.astro';

const { transformations } = site;
---

<section class="tf section section--charcoal" id="ugyfelek" aria-labelledby="tf-title">
  <div class="container">
    <SectionHeading id="tf-title" kicker={transformations.kicker} title={transformations.title} size="xl" />

    <div class="tf__list">
      {
        transformations.items.map((t, i) => (
          <article class:list={['case', i % 2 === 1 && 'case--flip']} aria-label={`${t.name} története`}>
            <figure class="case__media frame frame--editorial" data-reveal="image">
              <Image
                src={t.image}
                alt={t.imageAlt}
                widths={[480, 720, 960, 1280]}
                sizes="(min-width: 64em) 45vw, 100vw"
                loading="lazy"
                decoding="async"
              />
              <figcaption class="case__tag">
                <span>{t.name}</span>, {t.age}
              </figcaption>
            </figure>

            <div class="case__body" data-stagger="110" data-delay="200">
              <p class="case__goal" data-reveal="up">
                <span class="caption">Cél</span>
                {t.goal}
              </p>
              <p class="case__result" data-reveal="up">
                <span class="case__result-value num">
                  {t.result.value}
                  <small>{t.result.unit}</small>
                </span>
                <span class="caption">{t.result.period}</span>
              </p>
              <blockquote class="case__quote" data-reveal="up">
                <p>„{t.quote}”</p>
                <footer>
                  — {t.name}, {t.age}
                </footer>
              </blockquote>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tf__list {
    display: grid;
    gap: clamp(5rem, 12vw, 10rem);
    margin-top: clamp(4rem, 9vw, 7rem);
  }
  .case {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.4vw, 2.5rem);
    row-gap: 2.5rem;
    align-items: end;
  }
  .case__media {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 5;
  }
  .case__tag {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    padding: 0.5rem 0.8rem;
    background: var(--black);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .case__tag span {
    color: var(--accent);
  }
  .case__body {
    grid-column: 1 / -1;
    display: grid;
    gap: 2rem;
  }
  .case__goal {
    display: grid;
    gap: 0.4rem;
    font-size: 1.15rem;
    font-weight: 600;
  }
  .case__result {
    display: grid;
    gap: 0.6rem;
    padding-block: 1.5rem;
    border-block: 1px solid var(--line);
  }
  .case__result-value {
    font-size: clamp(5.5rem, 16vw, 11rem);
    color: var(--accent);
  }
  .case__result-value small {
    font-size: 0.4em;
    margin-left: 0.15em;
    color: var(--off-white);
  }
  .case__quote p {
    font-size: clamp(1.15rem, 1rem + 0.7vw, 1.55rem);
    line-height: 1.45;
    max-width: 30ch;
  }
  .case__quote footer {
    margin-top: 1rem;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (min-width: 48em) {
    .case__media {
      grid-column: 1 / 8;
    }
    .case__body {
      grid-column: 8 / -1;
    }
    .case--flip .case__media {
      grid-column: 6 / -1;
      grid-row: 1;
    }
    .case--flip .case__body {
      grid-column: 1 / 6;
      grid-row: 1;
    }
  }
  @media (min-width: 64em) {
    .case__media {
      grid-column: 1 / 7;
    }
    .case__body {
      grid-column: 8 / -1;
      padding-bottom: 2rem;
    }
    .case--flip .case__media {
      grid-column: 7 / -1;
      margin-top: 0;
    }
    .case--flip .case__body {
      grid-column: 1 / 6;
    }
  }
</style>
