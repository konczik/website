---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import { richLines, pad2 } from '../lib/text';
import Arrow from './ui/Arrow.astro';

const { problem } = site;
---

<section class="problem section" id="problema" aria-labelledby="problem-title">
  <div class="container grid problem__grid">
    <div class="problem__questions">
      <p class="kicker" data-reveal="up">{problem.kicker}</p>
      <ol class="problem__list" data-stagger="110">
        {
          problem.items.map((q, i) => (
            <li class="problem__item" data-reveal="up">
              <span class="problem__num">{pad2(i + 1)}</span>
              <span class="problem__q">{q}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <figure class="problem__figure frame frame--editorial" data-reveal="image">
      <Image
        src={problem.image}
        alt={problem.imageAlt}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 64em) 34vw, 100vw"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="problem__solution">
      <h2 id="problem-title" class="display display--lg" data-reveal="mask" set:html={richLines(problem.solution)} />
      <p class="lead muted" data-reveal="up" data-delay="200">{problem.solutionText}</p>
      <a href={problem.cta.href} class="link-arrow" data-reveal="up" data-delay="300">
        {problem.cta.label}
        <Arrow />
      </a>
    </div>
  </div>
</section>

<style>
  .problem__grid {
    row-gap: clamp(3.5rem, 8vw, 7rem);
  }
  .problem__questions,
  .problem__figure,
  .problem__solution {
    grid-column: 1 / -1;
  }
  .problem__questions {
    display: grid;
    gap: 2rem;
    align-content: start;
  }
  .problem__list {
    border-top: 1px solid var(--line);
  }
  .problem__item {
    display: flex;
    align-items: baseline;
    gap: clamp(1rem, 2vw, 2rem);
    padding-block: clamp(1rem, 2.2vw, 1.6rem);
    border-bottom: 1px solid var(--line);
  }
  .problem__num {
    flex: none;
    width: 2rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .problem__q {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4.4vw, 3.6rem);
    line-height: 1;
    text-transform: uppercase;
    color: rgb(242 239 233 / 0.4);
    transition: color 500ms var(--ease);
  }
  .problem__item:hover .problem__q {
    color: var(--off-white);
  }

  .problem__figure {
    aspect-ratio: 4 / 5;
    max-height: 80vh;
  }

  .problem__solution {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .problem__solution .lead {
    max-width: 42ch;
  }

  @media (min-width: 48em) {
    .problem__figure {
      grid-column: 4 / -1;
      aspect-ratio: 16 / 11;
    }
  }
  @media (min-width: 64em) {
    .problem__questions {
      grid-column: 1 / 8;
      grid-row: 1;
    }
    .problem__figure {
      grid-column: 9 / -1;
      grid-row: 1 / 3;
      aspect-ratio: 3 / 4.4;
      align-self: start;
      margin-top: 4rem;
    }
    .problem__solution {
      grid-column: 1 / 8;
      grid-row: 2;
    }
  }
</style>
