---
import { Image } from 'astro:assets';
import { site } from '../config/site';
import { richLines } from '../lib/text';

const { problem } = site;
---

<section class="problem section" id="problema" aria-labelledby="problem-title">
  <div class="container grid problem__grid">
    <div class="problem__questions">
      <p class="kicker" data-reveal="up">{problem.intro}</p>
      <!-- Vizuális storytelling: a kérdéseket egymás után áthúzza egy vonal -->
      <ul class="problem__list" data-stagger="260" data-delay="150">
        {
          problem.items.map((q) => (
            <li class="problem__item" data-reveal="up">
              <span class="problem__q">{q}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="problem__figure frame frame--editorial" data-reveal="image">
      <Image
        src={problem.image}
        alt={problem.imageAlt}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 64em) 34vw, 100vw"
        loading="lazy"
        decoding="async"
      />
    </figure>

    <div class="problem__solution">
      <h2 id="problem-title" class="display display--lg" data-reveal="mask" set:html={richLines(problem.solution)} />
      <p class="lead muted" data-reveal="up" data-delay="200">{problem.solutionText}</p>
      <a href={problem.cta.href} class="text-link" data-reveal="up" data-delay="300">
        {problem.cta.label}
      </a>
    </div>
  </div>
</section>

<style>
  .problem__grid {
    row-gap: clamp(3.5rem, 8vw, 7rem);
  }
  .problem__questions,
  .problem__figure,
  .problem__solution {
    grid-column: 1 / -1;
  }
  .problem__questions {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  .problem__item {
    padding-block: clamp(0.35rem, 1vw, 0.6rem);
  }
  .problem__q {
    position: relative;
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(2.1rem, 5.4vw, 4.6rem);
    line-height: 1.08;
    text-transform: uppercase;
    color: var(--off-white);
    transition: color 900ms var(--ease);
  }
  /* Áthúzó vonal */
  .problem__q::after {
    content: '';
    position: absolute;
    left: -0.05em;
    right: -0.05em;
    top: 54%;
    height: max(3px, 0.07em);
    background: var(--accent);
    transform: scaleX(1);
    transform-origin: left;
  }
  .problem__item .problem__q {
    color: rgb(242 239 233 / 0.38);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .problem__item .problem__q {
      color: var(--off-white);
    }
    :global(.js) .problem__q::after {
      transform: scaleX(0);
      transition: transform 900ms var(--ease-in-out);
    }
    :global(.js) .problem__item:global(.is-in) .problem__q {
      color: rgb(242 239 233 / 0.38);
      transition-delay: calc(var(--delay, 0ms) + 750ms);
    }
    :global(.js) .problem__item:global(.is-in) .problem__q::after {
      transform: scaleX(1);
      transition-delay: calc(var(--delay, 0ms) + 650ms);
    }
  }

  .problem__figure {
    aspect-ratio: 4 / 5;
    max-height: 80vh;
  }

  .problem__solution {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }
  .problem__solution .lead {
    max-width: 42ch;
  }

  @media (min-width: 48em) {
    .problem__figure {
      grid-column: 4 / -1;
      aspect-ratio: 16 / 11;
    }
  }
  @media (min-width: 64em) {
    .problem__questions {
      grid-column: 1 / 8;
      grid-row: 1;
    }
    .problem__figure {
      grid-column: 9 / -1;
      grid-row: 1 / 3;
      aspect-ratio: 3 / 4.4;
      align-self: start;
      margin-top: 4rem;
    }
    .problem__solution {
      grid-column: 1 / 8;
      grid-row: 2;
    }
  }
</style>
