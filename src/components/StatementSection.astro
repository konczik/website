---
import { site } from '../config/site';
import { richLines, plain } from '../lib/text';

const { statement } = site;
---

<section class="statement section section--light" id="statement" aria-labelledby="statement-title">
  <div class="container">
    <h2 id="statement-title" class="statement__title">
      <span class="sr-only">{plain(statement.setup)} {plain(statement.punchline)}</span>
      <span class="display statement__setup" data-reveal="mask" aria-hidden="true" set:html={richLines(statement.setup)} />
      <span class="display statement__punch" data-reveal="mask" data-delay="350" aria-hidden="true" set:html={richLines(statement.punchline)} />
    </h2>
  </div>
</section>

<style>
  .statement {
    padding-block: clamp(7rem, 16vw, 13rem);
  }
  .statement__title {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    font-weight: 400;
  }
  .statement__setup {
    display: block;
    font-size: clamp(2rem, 4.6vw, 4.4rem);
    line-height: 1.04;
    color: var(--ink-muted);
  }
  /* A punchline az oldal tipográfiai csúcspontja: kitölti a sort */
  .statement__punch {
    display: block;
    font-size: clamp(5rem, 21vw, 21rem);
    line-height: 0.98;
    letter-spacing: -0.015em;
  }
  @media (min-width: 64em) {
    .statement__title {
      grid-template-columns: 5fr 7fr;
      align-items: end;
    }
    .statement__setup {
      padding-bottom: 1.2rem;
    }
    .statement__punch {
      font-size: clamp(5rem, 13.5vw, 14rem);
    }
  }
</style>
