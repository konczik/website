---
import { Image } from 'astro:assets';
import { site, bookingHref } from '../config/site';
import SectionHeading from './SectionHeading.astro';

const { services } = site;
---

<section class="services section section--charcoal" id="szolgaltatasok" aria-labelledby="services-title">
  <div class="container">
    <SectionHeading id="services-title" title={services.title} size="xl" />

    <ul class="services__list">
      {
        services.items.map((s, i) => {
          const href = s.cta.href || bookingHref;
          return (
            <li class:list={['service', i % 2 === 1 && 'service--flip']} id={`szolgaltatas-${s.id}`}>
              <figure class="service__media frame frame--editorial" data-reveal="image">
                <Image
                  src={s.image}
                  alt={s.imageAlt}
                  widths={[480, 720, 960, 1280, 1600]}
                  sizes="(min-width: 64em) 55vw, 100vw"
                  loading="lazy"
                  decoding="async"
                />
              </figure>

              <div class="service__body" data-stagger="100" data-delay="150">
                <div class="service__intro" data-reveal="up">
                  <p class="service__format">{s.format}</p>
                  <h3 class="display display--md service__title">{s.title}</h3>
                </div>
                <div class="service__copy" data-reveal="up">
                  <p class="service__lead">{s.lead}</p>
                  <p class="muted">{s.text}</p>
                </div>
                <ul class="service__bullets" data-reveal="up">
                  {s.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
                <div class="service__foot" data-reveal="up">
                  {s.price && <p class="service__price">{s.price}</p>}
                  <a href={href} class="text-link">
                    {s.cta.label}
                    <span class="sr-only"> ({s.title})</span>
                  </a>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .services__list {
    display: grid;
    gap: clamp(5rem, 12vw, 10rem);
    margin-top: clamp(4rem, 9vw, 8rem);
  }
  .service {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2.4vw, 2.5rem);
    row-gap: 2rem;
    align-items: end;
  }
  .service__media {
    grid-column: 1 / -1;
    aspect-ratio: 4 / 5;
  }
  .service__body {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.1rem;
    max-width: 30rem;
  }
  .service__intro,
  .service__copy {
    display: grid;
    gap: 0.75rem;
  }
  .service__format {
    font-size: 0.95rem;
    color: var(--accent);
  }
  .service__lead {
    font-size: 1.15rem;
    font-weight: 600;
  }
  .service__bullets {
    display: grid;
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
  .service__bullets li {
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
    color: rgb(242 239 233 / 0.82);
  }
  .service__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 0.75rem;
  }
  .service__price {
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  @media (min-width: 48em) {
    .service__media {
      grid-column: 1 / 9;
      aspect-ratio: 4 / 3;
    }
    .service__body {
      grid-column: 5 / -1;
    }
    .service--flip .service__media {
      grid-column: 5 / -1;
    }
    .service--flip .service__body {
      grid-column: 1 / 8;
    }
  }
  @media (min-width: 64em) {
    .service {
      align-items: center;
    }
    .service__media {
      grid-column: 1 / 8;
      grid-row: 1;
      aspect-ratio: 4 / 4.6;
    }
    .service__body {
      grid-column: 9 / -1;
      grid-row: 1;
      margin-top: 0;
      padding: 0;
      background: none;
    }
    .service--flip .service__media {
      grid-column: 6 / -1;
    }
    .service--flip .service__body {
      grid-column: 1 / 5;
    }
    .service:nth-child(2) .service__media {
      aspect-ratio: 16 / 11;
    }
  }
</style>
