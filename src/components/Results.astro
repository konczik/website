---
import { site } from '../config/site';
import SectionHeading from './SectionHeading.astro';

const { results, brand } = site;
const h = results.highlight;
const fmt = (v: number, d = 0) =>
  new Intl.NumberFormat(brand.numberLocale, { minimumFractionDigits: d, maximumFractionDigits: d }).format(v);
---

<section class="results section" id="eredmenyek" aria-labelledby="results-title" data-locale={brand.numberLocale}>
  <div class="container">
    <SectionHeading id="results-title" title={results.title} size="lg" />

    <dl class="results__stats" data-stagger="120">
      {
        results.stats.map((s) => (
          <div class="stat" data-reveal="up">
            <dt class="stat__label">{s.label}</dt>
            <dd class="stat__value num">
              {s.prefix && <span class="stat__affix">{s.prefix}</span>}
              <span data-count={s.value} data-decimals={s.decimals ?? 0} data-count-delay="150">
                {fmt(s.value, s.decimals ?? 0)}
              </span>
              {s.suffix && <span class="stat__affix">{s.suffix}</span>}
            </dd>
          </div>
        ))
      }
    </dl>

    <figure class="highlight">
      <p class="highlight__value num">
        <span class="sr-only">{`${h.prefix ?? ''}${h.value}${h.suffix ?? ''}`}</span>
        <span aria-hidden="true">
          {h.prefix}<span data-count={h.value} data-decimals="0" data-count-delay="200">{fmt(h.value)}</span>{h.suffix}
        </span>
      </p>
      <figcaption class="highlight__label" data-reveal="up" data-delay="300">{h.label}</figcaption>
    </figure>

    <p class="results__note muted" data-reveal="fade">{results.note}</p>
  </div>
</section>

<style>
  .results__stats {
    display: grid;
    margin-top: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.75rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }
  .stat__label {
    font-size: 1rem;
    color: var(--muted);
  }
  .stat__value {
    display: flex;
    align-items: baseline;
    font-size: clamp(5rem, 15vw, 10.5rem);
  }
  .stat__affix {
    color: var(--accent);
  }

  .highlight {
    display: grid;
    gap: 1.25rem;
    margin-top: clamp(4.5rem, 11vw, 9rem);
  }
  .highlight__value {
    font-size: clamp(6.5rem, 27vw, 24rem);
    line-height: 0.82;
    letter-spacing: -0.02em;
    color: var(--accent);
    white-space: nowrap;
  }
  .highlight__label {
    max-width: 30ch;
    font-size: clamp(1.05rem, 1rem + 0.3vw, 1.25rem);
    line-height: 1.45;
  }
  .results__note {
    margin-top: 3.5rem;
    font-size: 0.85rem;
  }

  @media (min-width: 48em) {
    .results__stats {
      grid-template-columns: repeat(3, 1fr);
      border-bottom: 1px solid var(--line);
    }
    .stat {
      padding: 2.5rem 2rem 2.5rem 0;
      border-bottom: 0;
    }
    .stat + .stat {
      padding-left: 2rem;
      border-left: 1px solid var(--line);
    }
    .stat__value {
      font-size: clamp(4.5rem, 9.5vw, 10rem);
    }
  }
  @media (min-width: 64em) {
    .highlight {
      grid-template-columns: auto 1fr;
      align-items: end;
      column-gap: 3rem;
    }
    .highlight__label {
      padding-bottom: 2rem;
      justify-self: end;
      text-align: right;
    }
  }
</style>
